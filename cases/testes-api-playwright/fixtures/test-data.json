        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": true
    },
    {
      "name": "título de um caractere",
      "payload": {
        "userId": 1,
        "title": "A",
        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": true
    },
    {
      "name": "título de 255 caracteres",
      "payload": {
        "userId": 1,
        "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": true
    },
    {
      "name": "título de 256 caracteres",
      "payload": {
        "userId": 1,
        "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": true
    },
    {
      "name": "título vazio aceito pela API simulada",
      "payload": {
        "userId": 1,
        "title": "",
        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": false
    },
    {
      "name": "tipos incorretos aceitos pela API simulada",
      "payload": {
        "userId": "um",
        "title": 42,
        "body": "Conteúdo válido."
      },
      "expectedStatus": 201,
      "expectedContractValid": false
    },
    {
      "name": "corpo vazio aceito pela API simulada",
      "payload": {
        "userId": 1,
        "title": "Título válido",
        "body": ""
      },
      "expectedStatus": 201,
      "expectedContractValid": false
